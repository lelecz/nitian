<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#FFD3E0" />
            <corners android:radius="26dp" />
            <stroke android:width="1.5dp" android:color="@color/mac_pink" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/mac_pink_soft" />
            <corners android:radius="26dp" />
            <stroke android:width="1.5dp" android:color="@color/mac_pink" />
        </shape>
    </item>
</selector>
