<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:startColor="#F06E94" android:endColor="#9D8AE8" android:angle="0" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#E9DCE4" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:startColor="#FF8FAB" android:endColor="#B8A9F0" android:angle="0" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</selector>
